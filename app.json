{
  "expo": {
    "name": "Zém Tarif",
    "slug": "zem-tarif",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zemtarif",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F1EA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "bj.zemtarif.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Zém Tarif utilise votre position uniquement pour proposer un point de départ."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F1EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "bj.zemtarif.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F1EA"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Zém Tarif utilise votre position uniquement pour proposer un point de départ."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
